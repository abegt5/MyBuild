{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "src/app.js",
    "src/app/(tabs)/Edit.js",
    "src/app/Onboarding.js",
    "src/app/(tabs)/AddPost.js",
    "src/app/(tabs)/Account.js",
    "src/profile.js",
    "src/app/(tabs)/Events.js",
    "src/config/firebaseConfig.js",
    "nativewind-env.d.ts"
, "src/app/SignUp.tsx"  ]
}
